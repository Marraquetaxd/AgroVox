    </mxCell>

    <mxCell id="s2" value="Instalado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3DE;strokeColor=#3B6D11;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="320" y="210" width="160" height="50" as="geometry" />
    </mxCell>

    <mxCell id="s3" value="Activo (Midiendo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B7E4C7;strokeColor=#0F6E56;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="320" y="330" width="160" height="60" as="geometry" />
    </mxCell>

    <mxCell id="s4" value="Alerta Generada" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAC775;strokeColor=#854F0B;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="600" y="335" width="160" height="50" as="geometry" />
    </mxCell>

    <mxCell id="s5" value="Batería Baja" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAC775;strokeColor=#854F0B;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="60" y="335" width="160" height="50" as="geometry" />
    </mxCell>

    <mxCell id="s6" value="Desconectado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5B7A6;strokeColor=#A33B1E;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="320" y="480" width="160" height="50" as="geometry" />
    </mxCell>

    <mxCell id="s7" value="En Mantenimiento" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9FE1CB;strokeColor=#0F6E56;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="320" y="610" width="160" height="50" as="geometry" />
    </mxCell>

    <mxCell id="end" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2C2C2A;strokeColor=#2C2C2A;" vertex="1" parent="1">
      <mxGeometry x="386" y="710" width="24" height="24" as="geometry" />
    </mxCell>

    <!-- Linear transitions (no ambiguity, kept simple) -->
    <mxCell id="t1" value="se crea en BD" style="html=1;fontSize=10;endArrow=block;" edge="1" parent="1" source="start" target="s1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="t2" value="técnico instala" style="html=1;fontSize=10;endArrow=block;" edge="1" parent="1" source="s1" target="s2">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="t3" value="primer heartbeat" style="html=1;fontSize=10;endArrow=block;" edge="1" parent="1" source="s2" target="s3">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="t8" value="batería agotada" style="html=1;fontSize=10;endArrow=block;" edge="1" parent="1" source="s5" target="s6">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="t13" value="baja definitiva" style="html=1;fontSize=10;endArrow=block;" edge="1" parent="1" source="s7" target="end">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Activo <-> Alerta Generada (separadas: una arriba, una abajo) -->
    <mxCell id="t4" value="evento supera umbral" style="html=1;fontSize=10;endArrow=block;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s4">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="t5" value="alerta enviada" style="html=1;fontSize=10;endArrow=block;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="s3">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Activo <-> Batería Baja (separadas: una arriba, una abajo) -->
    <mxCell id="t6" value="batería &lt; 20%" style="html=1;fontSize=10;endArrow=block;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s5">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="t7" value="recarga solar" style="html=1;fontSize=10;endArrow=block;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5" target="s3">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Activo <-> Desconectado (separadas: izquierda baja, derecha sube) -->
    <mxCell id="t9" value="timeout LoRa" style="html=1;fontSize=10;endArrow=block;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s6">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="t10" value="reconexión" style="html=1;fontSize=10;endArrow=block;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s6" target="s3">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Desconectado -> Mantenimiento (columna central) -->
    <mxCell id="t11" value="desconexión prolongada" style="html=1;fontSize=10;endArrow=block;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s6" target="s7">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Mantenimiento -> Activo: enrutada por la derecha para NO pisar la línea anterior -->
    <mxCell id="t12" value="mantenimiento completado" style="html=1;fontSize=10;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="s7" target="s3">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="640" y="635" />
          <mxPoint x="640" y="360" />
        </Array>
      </mxGeometry>
    </mxCell>

  </root>
</mxGraphModel>
