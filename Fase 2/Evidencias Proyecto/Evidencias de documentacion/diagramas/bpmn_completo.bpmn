<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_AgroVox" targetNamespace="http://agrovox.cl/bpmn">
  <bpmn:collaboration id="Collab_AgroVox">
    <bpmn:participant id="Pool_Sistema" name="Sistema AgroVox" processRef="Process_Sistema" />
    <bpmn:participant id="Pool_Agricultor" name="Agricultor" processRef="Process_Agricultor" />
    <bpmn:messageFlow id="MF1" name="Mensaje WhatsApp" sourceRef="Task_Enviar" targetRef="Task_Recibir" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Sistema" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_nodo" name="Nodo (Edge)"><bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Capturar</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Clasificar</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_Cavitacion</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Descarta</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Transmitir</bpmn:flowNodeRef><bpmn:flowNodeRef>Bd_LoRa</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_ReLoRa</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Desconectado</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_backend" name="Backend Cloud"><bpmn:flowNodeRef>Task_Registrar</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Evaluar</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_Umbral</bpmn:flowNodeRef><bpmn:flowNodeRef>End_SinAlerta</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Generar</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Enviar</bpmn:flowNodeRef><bpmn:flowNodeRef>Bd_WA</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_ReWA</bpmn:flowNodeRef><bpmn:flowNodeRef>End_NoEntregada</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Inicio"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Task_Capturar" name="Capturar señal acústica"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_Clasificar" name="Clasificar evento (TinyML)"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Gw_Cavitacion" name="¿Es cavitación?"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing><bpmn:outgoing>F5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Descarta" name="Descarta evento (sigue midiendo)"><bpmn:incoming>F4</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_Transmitir" name="Transmitir vía LoRa"><bpmn:incoming>F5</bpmn:incoming><bpmn:incoming>F7</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_Registrar" name="Registrar evento en BD"><bpmn:incoming>F9</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_Evaluar" name="Evaluar umbral P50/P88"><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Gw_Umbral" name="¿Supera umbral?"><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing><bpmn:outgoing>F13</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_SinAlerta" name="Evento registrado sin alerta"><bpmn:incoming>F12</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_Generar" name="Generar alerta"><bpmn:incoming>F13</bpmn:incoming><bpmn:outgoing>F14</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_Enviar" name="Enviar notificación WhatsApp"><bpmn:incoming>F14</bpmn:incoming><bpmn:incoming>F16</bpmn:incoming></bpmn:task>
    <bpmn:boundaryEvent id="Bd_LoRa" name="Fallo de transmisión" attachedToRef="Task_Transmitir"><bpmn:outgoing>F6</bpmn:outgoing><bpmn:errorEventDefinition id="Bd_LoRa_err" /></bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gw_ReLoRa" name="¿Reintentos &lt; 3?"><bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing><bpmn:outgoing>F8</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Desconectado" name="Nodo pasa a estado Desconectado"><bpmn:incoming>F8</bpmn:incoming></bpmn:endEvent>
    <bpmn:boundaryEvent id="Bd_WA" name="Fallo de entrega" attachedToRef="Task_Enviar"><bpmn:outgoing>F15</bpmn:outgoing><bpmn:errorEventDefinition id="Bd_WA_err" /></bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gw_ReWA" name="¿Reintentos &lt; 3?"><bpmn:incoming>F15</bpmn:incoming><bpmn:outgoing>F16</bpmn:outgoing><bpmn:outgoing>F17</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_NoEntregada" name="Alerta no entregada (reintentar más tarde)"><bpmn:incoming>F17</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Capturar" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Capturar" targetRef="Task_Clasificar" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Clasificar" targetRef="Gw_Cavitacion" />
    <bpmn:sequenceFlow id="F4" name="No" sourceRef="Gw_Cavitacion" targetRef="End_Descarta" />
    <bpmn:sequenceFlow id="F5" name="Sí" sourceRef="Gw_Cavitacion" targetRef="Task_Transmitir" />
    <bpmn:sequenceFlow id="F9" name="Envío por LoRa → Gateway → MQTT" sourceRef="Task_Transmitir" targetRef="Task_Registrar" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Registrar" targetRef="Task_Evaluar" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Evaluar" targetRef="Gw_Umbral" />
    <bpmn:sequenceFlow id="F12" name="No" sourceRef="Gw_Umbral" targetRef="End_SinAlerta" />
    <bpmn:sequenceFlow id="F13" name="Sí" sourceRef="Gw_Umbral" targetRef="Task_Generar" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_Generar" targetRef="Task_Enviar" />
    <bpmn:sequenceFlow id="F6" sourceRef="Bd_LoRa" targetRef="Gw_ReLoRa" />
    <bpmn:sequenceFlow id="F7" name="Sí (reintentar)" sourceRef="Gw_ReLoRa" targetRef="Task_Transmitir" />
    <bpmn:sequenceFlow id="F8" name="No" sourceRef="Gw_ReLoRa" targetRef="End_Desconectado" />
    <bpmn:sequenceFlow id="F15" sourceRef="Bd_WA" targetRef="Gw_ReWA" />
    <bpmn:sequenceFlow id="F16" name="Sí (reintentar)" sourceRef="Gw_ReWA" targetRef="Task_Enviar" />
    <bpmn:sequenceFlow id="F17" name="No" sourceRef="Gw_ReWA" targetRef="End_NoEntregada" />
  </bpmn:process>
  <bpmn:process id="Process_Agricultor" isExecutable="false">
    <bpmn:receiveTask id="Task_Recibir" name="Recibir alerta"><bpmn:outgoing>F18</bpmn:outgoing></bpmn:receiveTask>
    <bpmn:task id="Task_Regar" name="Regar sector afectado"><bpmn:incoming>F18</bpmn:incoming><bpmn:outgoing>F19</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_Regado" name="Cultivo regado a tiempo"><bpmn:incoming>F19</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F18" sourceRef="Task_Recibir" targetRef="Task_Regar" />
    <bpmn:sequenceFlow id="F19" sourceRef="Task_Regar" targetRef="End_Regado" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collab_AgroVox">
